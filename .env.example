# ──────────────────────────────────────────────
# ServicePro — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit your real .env file.

# Database (SQLite for local dev)
DATABASE_URL="file:./dev.db"

# ──────────────────────────────────────────────
# GoHighLevel Integration (production only)
# ──────────────────────────────────────────────
# These are NOT required to run the local preview.
# Configure them when deploying with live GHL integration.
# See docs/INTEGRATIONS.md for setup instructions.

# GHL API key (OAuth private integration or API key)
# GHL_API_KEY=""

# GHL location ID (sub-account)
# GHL_LOCATION_ID=""

# GHL webhook URL for form submissions
# GHL_WEBHOOK_URL=""

# ──────────────────────────────────────────────
# Optional: image generation (for hero images)
# ──────────────────────────────────────────────
# See docs/INSTALLATION.md#hero-images
